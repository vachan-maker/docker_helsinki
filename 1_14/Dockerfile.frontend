FROM ubuntu:24.04

WORKDIR /usr/src/app

EXPOSE 5001 

COPY 1_12 .

RUN apt-get update && apt-get install -y curl

RUN curl -sL https://deb.nodesource.com/setup_16.x | bash

RUN apt install -y nodejs

RUN npm install && npm run build

RUN npm install -g serve

CMD ["serve" ,"-s" ,"-l", "5001" ,"build"]